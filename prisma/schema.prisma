// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(cuid())
  uid        String?  @unique
  email      String   @unique
  username   String?  @unique
  password   String
  name       String?
  role       String   @default("customer") // customer, developer, admin
  isBanned   Boolean  @default(false)
  secretCode String?
  isVerified Boolean  @default(false)
  verificationToken String? @unique
  resetToken String? @unique
  resetTokenExpiry DateTime?
  bep20Address     String?
  bep20QrUrl       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products     Product[]
  transactions Transaction[]
  licenses     License[]
  withdrawals  Withdrawal[]
  royalties    Royalty[]
  tickets      Ticket[]
  ticketMessages TicketMessage[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  platform    String    // MT4, MT5, Android
  icon        String?
  products    Product[]
}

model Product {
  id              String   @id @default(cuid())
  pid             String?  @unique
  slug            String   @unique @default(cuid())
  title           String
  description     String
  price           Float
  logoUrl         String?
  sourceFileUrl   String?
  compiledFileUrl String?
  status          String   @default("pending") // pending, published, rejected
  platform        String   // MT4, MT5, Android
  developerId     String
  categoryId      String

  developer User     @relation(fields: [developerId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  licenses     License[]
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  productId String
  amount    Float
  status    String   @default("completed") // completed, pending, failed
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  royalty Royalty?
}

model Royalty {
  id              String   @id @default(cuid())
  transactionId   String   @unique
  developerId     String
  saleAmount      Float
  platformFee     Float
  royaltyAmount   Float
  status          String   @default("pending") // pending, paid
  createdAt       DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  developer   User        @relation(fields: [developerId], references: [id], onDelete: Cascade)
}

model License {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id          String   @id @default(cuid())
  developerId String
  amount      Float
  status      String   @default("pending") // pending, completed, rejected
  createdAt   DateTime @default(now())

  developer   User     @relation(fields: [developerId], references: [id], onDelete: Cascade)
}

model Setting {
  id    String @id @default("global")
  data  Json
}

model Ticket {
  id        String   @id @default(cuid())
  subject   String
  status    String   @default("open") // open, resolved
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketMessage {
  id        String   @id @default(cuid())
  content   String
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String   
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
}

